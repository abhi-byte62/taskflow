# Environment
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production-please-64chars-minimum
JWT_EXPIRES=7d

# Redis (optional for production rate limiting, falls back to in-memory)
REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback